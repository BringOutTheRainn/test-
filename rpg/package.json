{
  "name": "emberdeep",
  "version": "0.1.0",
  "private": true,
  "description": "A turn-based dungeon RPG for phones.",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test tests/*.test.js",
