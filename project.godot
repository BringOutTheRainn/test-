; Engine configuration file.
; Edited by hand: this project is meant to be worked on as plain text.

config_version=5

[application]

config/name="City Builder RPG"
config/description="Mobile city builder with turn-based dungeon combat."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
Content="*res://src/core/content_db.gd"
Game="*res://src/core/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
