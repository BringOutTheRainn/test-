; Engine configuration file.
; Edited by hand: this project is meant to be worked on as plain text.

config_version=5

[application]

config/name="City Builder RPG"
config/description="Mobile city builder with turn-based dungeon combat."
config/version="0.3.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0941176, 0.0784314, 0.145098, 1)
boot_splash/show_image=false
run/max_fps=60

[autoload]

EventBus="*res://src/core/event_bus.gd"
Content="*res://src/core/content_db.gd"
Game="*res://src/core/game_state.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/city_notifications/plugin.cfg")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
